      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_FarmasiKasir_di" bpmnElement="Join_FarmasiKasir" isMarkerVisible="true">
        <dc:Bounds x="2460" y="1315" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2440" y="1285" width="90" height="24"/>
