        <di:waypoint x="1340" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTriase_di" bpmnElement="Flow_ToTriase">
        <di:waypoint x="1460" y="540"/>
