        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MergeAppt_di" bpmnElement="Flow_MergeAppt">
        <di:waypoint x="740" y="280"/>
        <di:waypoint x="980" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MergeWalkin_di" bpmnElement="Flow_MergeWalkin">
