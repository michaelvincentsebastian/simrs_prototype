        <di:waypoint x="1490" y="700"/>
        <di:waypoint x="1520" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PostTriase_di" bpmnElement="Flow_PostTriase">
        <di:waypoint x="1640" y="700"/>
        <di:waypoint x="1700" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToIGD_di" bpmnElement="Flow_ToIGD">
        <di:waypoint x="1750" y="700"/>
        <di:waypoint x="1810" y="700"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1765" y="682" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDokter_di" bpmnElement="Flow_ToDokter">
        <di:waypoint x="1750" y="700"/>
        <di:waypoint x="1780" y="700"/>
        <di:waypoint x="1780" y="860"/>
        <di:waypoint x="1810" y="860"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1750" y="682" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPelayananDokter_di" bpmnElement="Flow_ToPelayananDokter">
        <di:waypoint x="1930" y="860"/>
        <di:waypoint x="1990" y="860"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PostDokter_di" bpmnElement="Flow_PostDokter">
        <di:waypoint x="2110" y="860"/>
        <di:waypoint x="2170" y="860"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToFarmasi_di" bpmnElement="Flow_ToFarmasi">
        <di:waypoint x="2220" y="860"/>
        <di:waypoint x="2250" y="860"/>
        <di:waypoint x="2250" y="1020"/>
        <di:waypoint x="2280" y="1020"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToKasir_di" bpmnElement="Flow_ToKasir">
        <di:waypoint x="2220" y="860"/>
        <di:waypoint x="2250" y="860"/>
