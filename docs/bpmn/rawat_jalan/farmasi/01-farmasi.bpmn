      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="2540" y="280"/>
        <di:waypoint x="2570" y="280"/>
        <di:waypoint x="2570" y="700"/>
        <di:waypoint x="2600" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="2720" y="700"/>
