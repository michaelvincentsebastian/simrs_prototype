        <dc:Bounds x="2960" y="500" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PanggilUlang_di" bpmnElement="Task_PanggilUlang">
        <dc:Bounds x="2960" y="350" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PanggilanKe_di" bpmnElement="GW_PanggilanKe" isMarkerVisible="true">
        <dc:Bounds x="3140" y="255" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3120" y="225" width="90" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_Hadir_di" bpmnElement="Merge_Hadir" isMarkerVisible="true">
        <dc:Bounds x="3320" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
