      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LihatAntrian_di" bpmnElement="Task_LihatAntrian">
        <dc:Bounds x="1340" y="240" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PanggilPasien_di" bpmnElement="Task_PanggilPasien">
        <dc:Bounds x="1520" y="240" width="120" height="80"/>
      </bpmndi:BPMNShape>
