          <dc:Bounds x="3835" y="303" width="86" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01">
        <di:waypoint x="296" y="140"/>
        <di:waypoint x="440" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_di" bpmnElement="F02">
        <di:waypoint x="560" y="140"/>
        <di:waypoint x="620" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F03_di" bpmnElement="F03">
        <di:waypoint x="740" y="140"/>
        <di:waypoint x="800" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F04_di" bpmnElement="F04">
        <di:waypoint x="920" y="140"/>
        <di:waypoint x="950" y="140"/>
        <di:waypoint x="950" y="700"/>
        <di:waypoint x="980" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F05_di" bpmnElement="F05">
        <di:waypoint x="1100" y="700"/>
        <di:waypoint x="1130" y="700"/>
        <di:waypoint x="1130" y="540"/>
        <di:waypoint x="1160" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F06_di" bpmnElement="F06">
        <di:waypoint x="1280" y="540"/>
        <di:waypoint x="1310" y="540"/>
        <di:waypoint x="1310" y="280"/>
        <di:waypoint x="1340" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F07_di" bpmnElement="F07">
        <di:waypoint x="1460" y="280"/>
        <di:waypoint x="1520" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F08_di" bpmnElement="F08">
        <di:waypoint x="1640" y="280"/>
        <di:waypoint x="1670" y="280"/>
        <di:waypoint x="1670" y="140"/>
        <di:waypoint x="1700" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F09_di" bpmnElement="F09">
        <di:waypoint x="1820" y="140"/>
        <di:waypoint x="1880" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="2000" y="140"/>
        <di:waypoint x="2060" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="2180" y="140"/>
        <di:waypoint x="2210" y="140"/>
        <di:waypoint x="2210" y="700"/>
        <di:waypoint x="2240" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="2360" y="700"/>
        <di:waypoint x="2390" y="700"/>
        <di:waypoint x="2390" y="540"/>
        <di:waypoint x="2420" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13">
        <di:waypoint x="2540" y="540"/>
        <di:waypoint x="2570" y="540"/>
        <di:waypoint x="2570" y="280"/>
        <di:waypoint x="2600" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14">
        <di:waypoint x="2636" y="280"/>
        <di:waypoint x="2780" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Hadir_di" bpmnElement="F_Hadir">
        <di:waypoint x="2830" y="280"/>
        <di:waypoint x="2895" y="280"/>
