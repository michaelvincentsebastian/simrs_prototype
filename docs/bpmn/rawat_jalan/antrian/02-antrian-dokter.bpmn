<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AntrianDokter" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collab_AntrianDokter">
    <bpmn:participant id="Part_AntrianDokter" name="Antrian Dokter (§3.1-3.2, §8.1)" processRef="Proc_AntrianDokter"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_AntrianDokter" name="Antrian Dokter" isExecutable="false">
    <bpmn:documentation>
      Alur manajemen antrian dokter — dari triase selesai hingga dokter memanggil pasien.
      Queue type: DOCTOR. Antrian per poli/dokter.
      Status tiket: WAITING_DOCTOR → CALLED → IN_SERVICE.
      Hirarki: §3.1 Daftar Antrian Dokter, §3.2 Pemanggilan Pasien, §8.1 Display.
    </bpmn:documentation>
    <bpmn:laneSet id="LS_AntrianDokter">
      <bpmn:lane id="Lane_Sistem" name="Sistem Antrian SIMRS">
        <bpmn:flowNodeRef>Start_DariTriase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PindahAntrianDokter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignPoliDokter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UrutkanAntrian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HitungEstimasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishDisplay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCalled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlayAudio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateServing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dokter" name="Dokter">
        <bpmn:flowNodeRef>Task_LihatAntrianDokter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSingkat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanggilPasien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PasienDatang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanggilUlang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MaxPanggilan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SkipPasien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Datang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MulaiPelayanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DalamPelayanan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pasien" name="Pasien">
        <bpmn:flowNodeRef>Task_TungguRuangTunggu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DengarPanggilan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MasukRuangPeriksa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_DariTriase" name="Triase selesai — pasien di-routing ke dokter">
      <bpmn:documentation>Trigger: status Visit = WAITING_DOCTOR setelah routing triase</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_PindahAntrianDokter" name="Pindahkan tiket ke antrian dokter">
      <bpmn:documentation>Queue Ticket type berubah dari TRIAGE → DOCTOR</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AssignPoliDokter" name="Assign ke antrian poli &amp; dokter spesifik">
      <bpmn:documentation>Filter berdasarkan appointment: poli tujuan + dokter yang dipilih</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UrutkanAntrian" name="Urutkan antrian (FIFO per dokter)">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_HitungEstimasi" name="Hitung estimasi waktu tunggu dokter">
      <bpmn:documentation>Rata-rata 15 menit per pasien × jumlah antrian depan</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PublishDisplay" name="Publish ke Display TV Poli">
      <bpmn:documentation>Hirarki: 8.1. Per-poli display. Tampilkan: no. tiket, urutan, ruang periksa.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_TungguRuangTunggu" name="Tunggu di ruang tunggu poli">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LihatAntrianDokter" name="Lihat daftar antrian di workstation dokter">
      <bpmn:documentation>Hirarki: 3.1. Tampilan: daftar pasien WAITING_DOCTOR, info singkat TTV &amp; keluhan.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewSingkat" name="Review singkat data triase pasien berikutnya">
      <bpmn:documentation>Preview: TTV terakhir, keluhan utama, alergi, flag risiko</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanggilPasien" name="Klik &quot;Panggil Pasien&quot;">
      <bpmn:documentation>Hirarki: 3.2. Tombol di workstation dokter.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UpdateCalled" name="Update tiket: WAITING → CALLED">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PlayAudio" name="Audio panggilan ke ruang periksa">
      <bpmn:documentation>"Nomor antrian D-005, silakan ke Ruang Praktik 2 dr. Hendra"</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DengarPanggilan" name="Dengar panggilan &amp; lihat display">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_PasienDatang" name="Pasien datang ke ruang periksa?" default="F_Tidak">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F_Ya</bpmn:outgoing>
      <bpmn:outgoing>F_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PanggilUlang" name="Panggil ulang">
      <bpmn:incoming>F_Tidak</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_MaxPanggilan" name="Sudah 3x panggil?" default="F_Belum">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F_Belum</bpmn:outgoing>
      <bpmn:outgoing>F_Sudah</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SkipPasien" name="Skip, lanjut pasien berikutnya">
      <bpmn:documentation>Status tiket: SKIPPED. Pasien bisa re-queue.</bpmn:documentation>
      <bpmn:incoming>F_Sudah</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MasukRuangPeriksa" name="Pasien masuk ruang periksa">
      <bpmn:incoming>F_Ya</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_Datang">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F_Belum</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_MulaiPelayanan" name="Mulai pelayanan dokter (IN_SERVICE)">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UpdateServing" name="Update Visit: WAITING_DOCTOR → IN_SERVICE">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DalamPelayanan" name="Pasien dalam pelayanan dokter">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_DariTriase" targetRef="Task_PindahAntrianDokter"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_PindahAntrianDokter" targetRef="Task_AssignPoliDokter"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Task_AssignPoliDokter" targetRef="Task_UrutkanAntrian"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Task_UrutkanAntrian" targetRef="Task_HitungEstimasi"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_HitungEstimasi" targetRef="Task_PublishDisplay"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_PublishDisplay" targetRef="Task_TungguRuangTunggu"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_TungguRuangTunggu" targetRef="Task_LihatAntrianDokter"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_LihatAntrianDokter" targetRef="Task_ReviewSingkat"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_ReviewSingkat" targetRef="Task_PanggilPasien"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_PanggilPasien" targetRef="Task_UpdateCalled"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_UpdateCalled" targetRef="Task_PlayAudio"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_PlayAudio" targetRef="Task_DengarPanggilan"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_DengarPanggilan" targetRef="GW_PasienDatang"/>
    <bpmn:sequenceFlow id="F_Ya" name="Ya" sourceRef="GW_PasienDatang" targetRef="Task_MasukRuangPeriksa"/>
    <bpmn:sequenceFlow id="F_Tidak" name="Tidak" sourceRef="GW_PasienDatang" targetRef="Task_PanggilUlang"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_PanggilUlang" targetRef="GW_MaxPanggilan"/>
    <bpmn:sequenceFlow id="F_Belum" name="Belum" sourceRef="GW_MaxPanggilan" targetRef="Merge_Datang"/>
    <bpmn:sequenceFlow id="F_Sudah" name="Sudah 3x" sourceRef="GW_MaxPanggilan" targetRef="Task_SkipPasien"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_SkipPasien" targetRef="End_DalamPelayanan"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_MasukRuangPeriksa" targetRef="Merge_Datang"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Merge_Datang" targetRef="Task_MulaiPelayanan"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_MulaiPelayanan" targetRef="Task_UpdateServing"/>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_UpdateServing" targetRef="End_DalamPelayanan"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_AntrianDokter">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_AntrianDokter" bpmnElement="Collab_AntrianDokter">
