        <di:waypoint x="2650" y="360"/>
        <di:waypoint x="2715" y="360"/>
        <di:waypoint x="2715" y="620"/>
        <di:waypoint x="2780" y="620"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2667" y="342" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Tidak_di" bpmnElement="F_Tidak">
        <di:waypoint x="2650" y="360"/>
        <di:waypoint x="2715" y="360"/>
        <di:waypoint x="2715" y="470"/>
        <di:waypoint x="2780" y="470"/>
