      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PublishDisplayKasir_di" bpmnElement="Task_PublishDisplayKasir">
        <dc:Bounds x="2240" y="100" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MenungguKasir_di" bpmnElement="Task_MenungguKasir">
