<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AntrianFarmasiKasir" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collab_AntrianFarmasiKasir">
    <bpmn:participant id="Part_AntrianFarmasiKasir" name="Antrian Farmasi dan Kasir (§5.1, §6.1, §8.1)" processRef="Proc_AntrianFarmasiKasir"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_AntrianFarmasiKasir" name="Antrian Farmasi dan Kasir" isExecutable="false">
    <bpmn:documentation>
      Alur manajemen antrian farmasi dan kasir setelah pelayanan dokter selesai.
      Queue types: PHARMACY (Farmasi) &amp; CASHIER (Kasir/Billing).
      Status tiket: WAITING → CALLED → IN_SERVICE → COMPLETED.
      Hirarki: §5.1 Antrian Resep Farmasi, §6.1 Antrian Pembayaran Kasir, §8.1 Queue Display.
    </bpmn:documentation>
    <bpmn:laneSet id="LS_AntrianFarmasiKasir">
      <bpmn:lane id="Lane_Sistem" name="Sistem Antrian SIMRS">
        <bpmn:flowNodeRef>Start_DariDokter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JenisAntrian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateTiketFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateTiketKasir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishDisplayFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishDisplayKasir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanggilAudioFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanggilAudioKasir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PetugasFarmasi" name="Petugas Farmasi / Apoteker">
        <bpmn:flowNodeRef>Task_LihatAntrianFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanggilPasienFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SerahkanObat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kasir" name="Kasir / Billing">
        <bpmn:flowNodeRef>Task_LihatAntrianKasir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanggilPasienKasir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProsesBayar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pasien" name="Pasien / Keluarga">
        <bpmn:flowNodeRef>Task_MenungguFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MenujuLoketFarmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MenungguKasir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MenujuLoketKasir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SelesaiLayanan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_DariDokter" name="Pelayanan dokter difinalisasi">
      <bpmn:documentation>Trigger: Doctor Encounter status = COMPLETED / Finalized</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_JenisAntrian" name="Apakah ada resep obat?">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F_AdaResep</bpmn:outgoing>
      <bpmn:outgoing>F_TanpaResep</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateTiketFarmasi" name="Generate Tiket Antrian Farmasi">
      <bpmn:documentation>Queue Ticket type = PHARMACY, prefix 'F', status = WAITING</bpmn:documentation>
      <bpmn:incoming>F_AdaResep</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PublishDisplayFarmasi" name="Publish ke Queue Display Farmasi">
      <bpmn:documentation>Realtime event: queue_update untuk layar tunggu farmasi</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MenungguFarmasi" name="Pasien menunggu di ruang tunggu farmasi">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LihatAntrianFarmasi" name="Petugas monitor daftar antrian farmasi">
      <bpmn:documentation>Menu 5.1: Daftar antrian resep &amp; status peracikan obat</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanggilPasienFarmasi" name="Panggil nomor antrian pasien farmasi">
      <bpmn:documentation>Tombol 'Panggil': status tiket diupdate menjadi CALLED</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PanggilAudioFarmasi" name="Bunyikan audio bell &amp; TTS loket farmasi">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MenujuLoketFarmasi" name="Pasien menuju loket penyerahan obat">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SerahkanObat" name="Verifikasi identitas, KIE &amp; serahkan obat">
      <bpmn:documentation>Menu 5.4: Penyerahan obat, tiket farmasi COMPLETED</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GenerateTiketKasir" name="Generate Tiket Antrian Kasir">
      <bpmn:documentation>Queue Ticket type = CASHIER, prefix 'K', status = WAITING</bpmn:documentation>
      <bpmn:incoming>F_TanpaResep</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PublishDisplayKasir" name="Publish ke Queue Display Kasir">
      <bpmn:documentation>Realtime event: queue_update untuk layar kasir</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MenungguKasir" name="Pasien menunggu antrian pembayaran">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LihatAntrianKasir" name="Kasir monitor daftar tagihan siap bayar">
      <bpmn:documentation>Menu 6.1: Antrian kasir &amp; rekap invoice</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanggilPasienKasir" name="Kasir panggil nomor antrian kasir">
      <bpmn:documentation>Status tiket: CALLED, update ke display</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PanggilAudioKasir" name="Bunyikan audio bell &amp; TTS loket kasir">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MenujuLoketKasir" name="Pasien menuju loket kasir">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProsesBayar" name="Proses pembayaran &amp; cetak kuitansi">
      <bpmn:documentation>Menu 6.4-6.5: Pelunasan invoice, tiket COMPLETED, Visit CLOSED</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_SelesaiLayanan" name="Pelayanan Farmasi &amp; Kasir Selesai">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_DariDokter" targetRef="GW_JenisAntrian"/>
    <bpmn:sequenceFlow id="F_AdaResep" name="Ada Resep" sourceRef="GW_JenisAntrian" targetRef="Task_GenerateTiketFarmasi"/>
    <bpmn:sequenceFlow id="F_TanpaResep" name="Tanpa Resep" sourceRef="GW_JenisAntrian" targetRef="Task_GenerateTiketKasir"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_GenerateTiketFarmasi" targetRef="Task_PublishDisplayFarmasi"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Task_PublishDisplayFarmasi" targetRef="Task_MenungguFarmasi"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Task_MenungguFarmasi" targetRef="Task_LihatAntrianFarmasi"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_LihatAntrianFarmasi" targetRef="Task_PanggilPasienFarmasi"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_PanggilPasienFarmasi" targetRef="Task_PanggilAudioFarmasi"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_PanggilAudioFarmasi" targetRef="Task_MenujuLoketFarmasi"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_MenujuLoketFarmasi" targetRef="Task_SerahkanObat"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_SerahkanObat" targetRef="Task_GenerateTiketKasir"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_GenerateTiketKasir" targetRef="Task_PublishDisplayKasir"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_PublishDisplayKasir" targetRef="Task_MenungguKasir"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_MenungguKasir" targetRef="Task_LihatAntrianKasir"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_LihatAntrianKasir" targetRef="Task_PanggilPasienKasir"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_PanggilPasienKasir" targetRef="Task_PanggilAudioKasir"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_PanggilAudioKasir" targetRef="Task_MenujuLoketKasir"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_MenujuLoketKasir" targetRef="Task_ProsesBayar"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_ProsesBayar" targetRef="End_SelesaiLayanan"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_AntrianFarmasiKasir">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_AntrianFarmasiKasir" bpmnElement="Collab_AntrianFarmasiKasir">
      <bpmndi:BPMNShape id="Part_AntrianFarmasiKasir_di" bpmnElement="Part_AntrianFarmasiKasir" isHorizontal="true">
