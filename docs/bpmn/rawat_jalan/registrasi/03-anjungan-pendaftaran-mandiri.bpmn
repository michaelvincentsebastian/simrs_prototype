<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Checkin" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collab_Checkin">
    <bpmn:participant id="Part_Checkin" name="KIOSK (Anjungan Pendaftaran Mandiri)" processRef="Proc_Checkin" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Checkin" name="Check-in &#38; Verifikasi" isExecutable="false">
    <bpmn:documentation>
      Alur detail check-in dan verifikasi setelah pasien terdaftar (baik walk-in maupun appointment).
      Mencakup: verifikasi identitas, verifikasi penjamin, pembuatan kunjungan, dan penerbitan tiket antrian.
      Hirarki: §1.4 Check-in, §1.5 Verifikasi Identitas, §1.6 Verifikasi Penjamin, §1.7 Antrian.
    </bpmn:documentation>
    <bpmn:laneSet id="LS_Checkin">
      <bpmn:lane id="Lane_Reg" name="Pasien">
        <bpmn:flowNodeRef>Task_VerifPenjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TipePenjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifBPJS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifAsuransi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Penjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PenjaminValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FallbackUmum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_PenjaminOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KonfirmasiCheckin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuatVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusArrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuatTiketAntrian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TampilDisplay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CetakTiket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Checkin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_062doky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_189p4bf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Checkin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1v2t15f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1946hwq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0dcjjlx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0ug5znq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem APM">
        <bpmn:flowNodeRef>Activity_0hgcrir</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_VerifPenjamin" name="Periksa skema penjamin yang dipilih">
      <bpmn:documentation>Hirarki: 1.6 Verifikasi Penjamin</bpmn:documentation>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_TipePenjamin" name="Tipe penjamin?" default="F_Umum">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F_Umum</bpmn:outgoing>
      <bpmn:outgoing>F_Asuransi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerifBPJS" name="Verifikasi eligibility BPJS (no. kartu, status aktif, faskes)">
      <bpmn:documentation>Cek: kartu BPJS aktif, faskes tingkat 1 sesuai, rujukan valid (jika perlu)</bpmn:documentation>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifAsuransi" name="Verifikasi polis asuransi swasta">
      <bpmn:documentation>Cek: polis aktif, coverage rawat jalan, limit tersisa, surat jaminan</bpmn:documentation>
      <bpmn:incoming>F_Asuransi</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_Penjamin">
      <bpmn:incoming>F_Umum</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_PenjaminValid" name="Penjamin valid?" default="F_TidakValid">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_TidakValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FallbackUmum" name="Pasien pilih Umum/Bayar Mandiri atau lengkapi dokumen">
      <bpmn:documentation>Jika penjamin tidak valid, pasien bisa fallback ke Umum atau lengkapi berkas</bpmn:documentation>
      <bpmn:incoming>F_TidakValid</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_PenjaminOK">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_KonfirmasiCheckin" name="Konfirmasi check-in (tombol &#34;Daftarkan &#38; Cetak Tiket&#34;)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BuatVisit" name="Buat Outpatient Visit (status: ARRIVED)">
      <bpmn:documentation>Hirarki: 1.4 Check-in. Outpatient Visit = orkestrator lifecycle kunjungan.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StatusArrived" name="Set Appointment status = CHECK_IN">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuatTiketAntrian" name="Buat Queue Ticket (format: T-NNN)">
      <bpmn:documentation>Hirarki: 1.7 Antrian Rawat Jalan. Status tiket: WAITING.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TampilDisplay" name="Tampilkan di Queue Display TV">
      <bpmn:documentation>Hirarki: 8.1. Realtime publish nomor antrian ke display. Zero PHI.</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CetakTiket" name="Cetak tiket antrian (thermal printer)">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_VerifPenjamin" targetRef="GW_TipePenjamin" />
    <bpmn:sequenceFlow id="F_Umum" name="Umum" sourceRef="GW_TipePenjamin" targetRef="Merge_Penjamin" />
    <bpmn:sequenceFlow id="F_Asuransi" name="Asuransi Swasta" sourceRef="GW_TipePenjamin" targetRef="Task_VerifAsuransi" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_VerifBPJS" targetRef="Merge_Penjamin" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_VerifAsuransi" targetRef="Merge_Penjamin" />
    <bpmn:sequenceFlow id="F09" sourceRef="Merge_Penjamin" targetRef="GW_PenjaminValid" />
    <bpmn:sequenceFlow id="F_Valid" name="Ya" sourceRef="GW_PenjaminValid" targetRef="Merge_PenjaminOK" />
    <bpmn:sequenceFlow id="F_TidakValid" name="Tidak" sourceRef="GW_PenjaminValid" targetRef="Task_FallbackUmum" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_FallbackUmum" targetRef="Merge_PenjaminOK" />
    <bpmn:sequenceFlow id="F11" sourceRef="Merge_PenjaminOK" targetRef="Task_KonfirmasiCheckin" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_KonfirmasiCheckin" targetRef="Task_BuatVisit" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_BuatVisit" targetRef="Task_StatusArrived" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_StatusArrived" targetRef="Task_BuatTiketAntrian" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_BuatTiketAntrian" targetRef="Task_TampilDisplay" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_TampilDisplay" targetRef="Task_CetakTiket" />
    <bpmn:endEvent id="End_Checkin" name="Pasien checked-in — menunggu panggilan triase">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_CetakTiket" targetRef="End_Checkin" />
    <bpmn:userTask id="Activity_062doky" name="Pilih opsi Appointment Check-in">
      <bpmn:documentation>Hirarki: 1.6 Verifikasi Penjamin</bpmn:documentation>
      <bpmn:incoming>Flow_17u842e</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_17u842e" name="Ya" sourceRef="Gateway_189p4bf" targetRef="Activity_062doky" />
    <bpmn:sequenceFlow id="Flow_1wp6r6v" name="Tidak" sourceRef="Gateway_189p4bf" targetRef="Activity_1v2t15f" />
    <bpmn:exclusiveGateway id="Gateway_189p4bf" name="Apakah sudah membuat Appointment?">
      <bpmn:incoming>Flow_0wlbfwq</bpmn:incoming>
      <bpmn:outgoing>Flow_17u842e</bpmn:outgoing>
      <bpmn:outgoing>Flow_1wp6r6v</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0wlbfwq" sourceRef="Start_Checkin" targetRef="Gateway_189p4bf" />
    <bpmn:startEvent id="Start_Checkin" name="Pasien ke terminal APM">
      <bpmn:outgoing>Flow_0wlbfwq</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1v2t15f" name="Pilih opsi Registrasi">
      <bpmn:documentation>Hirarki: 1.6 Verifikasi Penjamin</bpmn:documentation>
      <bpmn:incoming>Flow_1wp6r6v</bpmn:incoming>
      <bpmn:outgoing>Flow_0hj0aeb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1946hwq" name="Pasien Baru?">
      <bpmn:incoming>Flow_0hj0aeb</bpmn:incoming>
      <bpmn:outgoing>Flow_1te8g60</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tgz0rt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0hj0aeb" sourceRef="Activity_1v2t15f" targetRef="Gateway_1946hwq" />
    <bpmn:task id="Activity_0dcjjlx" name="Pilih Pasien Baru">
      <bpmn:incoming>Flow_1te8g60</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1te8g60" sourceRef="Gateway_1946hwq" targetRef="Activity_0dcjjlx" />
    <bpmn:task id="Activity_0ug5znq" name="Pilih Pasien Lama">
      <bpmn:incoming>Flow_1tgz0rt</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1tgz0rt" sourceRef="Gateway_1946hwq" targetRef="Activity_0ug5znq" />
    <bpmn:task id="Activity_0hgcrir" name="Pilih Pasien Lama" />
  </bpmn:process>
