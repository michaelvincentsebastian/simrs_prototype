<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Checkin" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collab_Checkin">
    <bpmn:participant id="Part_Checkin" name="Check-in &amp; Verifikasi (§1.4-1.6)" processRef="Proc_Checkin"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Checkin" name="Check-in &amp; Verifikasi" isExecutable="false">
    <bpmn:documentation>
      Alur detail check-in dan verifikasi setelah pasien terdaftar (baik walk-in maupun appointment).
      Mencakup: verifikasi identitas, verifikasi penjamin, pembuatan kunjungan, dan penerbitan tiket antrian.
      Hirarki: §1.4 Check-in, §1.5 Verifikasi Identitas, §1.6 Verifikasi Penjamin, §1.7 Antrian.
    </bpmn:documentation>
    <bpmn:laneSet id="LS_Checkin">
      <bpmn:lane id="Lane_Reg" name="Staf Registrasi">
        <bpmn:flowNodeRef>Start_Checkin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifIdentitas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CocokanWajah</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_IdentitasOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerbaikiData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Identitas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifPenjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TipePenjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifBPJS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifAsuransi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Penjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PenjaminValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FallbackUmum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_PenjaminOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KonfirmasiCheckin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem SIMRS">
        <bpmn:flowNodeRef>Task_BuatVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusArrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuatTiketAntrian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TampilDisplay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CetakTiket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Checkin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Checkin" name="Pasien terdaftar (dari walk-in / appointment)">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_VerifIdentitas" name="Verifikasi data identitas pasien di sistem">
      <bpmn:documentation>Hirarki: 1.5. Periksa: nama, tanggal lahir, NIK, alamat di layar vs dokumen fisik.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CocokanWajah" name="Cocokkan wajah pasien dengan foto KTP/data">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_IdentitasOK" name="Identitas cocok?" default="F_TidakCocok">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F_Cocok</bpmn:outgoing>
      <bpmn:outgoing>F_TidakCocok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerbaikiData" name="Perbaiki data pasien / minta dokumen tambahan">
      <bpmn:incoming>F_TidakCocok</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_Identitas">
      <bpmn:incoming>F_Cocok</bpmn:incoming>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerifPenjamin" name="Periksa skema penjamin yang dipilih">
      <bpmn:documentation>Hirarki: 1.6 Verifikasi Penjamin</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_TipePenjamin" name="Tipe penjamin?" default="F_Umum">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F_Umum</bpmn:outgoing>
      <bpmn:outgoing>F_BPJS</bpmn:outgoing>
      <bpmn:outgoing>F_Asuransi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerifBPJS" name="Verifikasi eligibility BPJS (no. kartu, status aktif, faskes)">
      <bpmn:documentation>Cek: kartu BPJS aktif, faskes tingkat 1 sesuai, rujukan valid (jika perlu)</bpmn:documentation>
      <bpmn:incoming>F_BPJS</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifAsuransi" name="Verifikasi polis asuransi swasta">
      <bpmn:documentation>Cek: polis aktif, coverage rawat jalan, limit tersisa, surat jaminan</bpmn:documentation>
      <bpmn:incoming>F_Asuransi</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_Penjamin">
      <bpmn:incoming>F_Umum</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_PenjaminValid" name="Penjamin valid?" default="F_TidakValid">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_TidakValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FallbackUmum" name="Pasien pilih Umum/Bayar Mandiri atau lengkapi dokumen">
      <bpmn:documentation>Jika penjamin tidak valid, pasien bisa fallback ke Umum atau lengkapi berkas</bpmn:documentation>
      <bpmn:incoming>F_TidakValid</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_PenjaminOK">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_KonfirmasiCheckin" name="Konfirmasi check-in (tombol &quot;Daftarkan &amp; Cetak Tiket&quot;)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BuatVisit" name="Buat Outpatient Visit (status: ARRIVED)">
      <bpmn:documentation>Hirarki: 1.4 Check-in. Outpatient Visit = orkestrator lifecycle kunjungan.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StatusArrived" name="Set Appointment status = CHECK_IN">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuatTiketAntrian" name="Buat Queue Ticket (format: T-NNN)">
      <bpmn:documentation>Hirarki: 1.7 Antrian Rawat Jalan. Status tiket: WAITING.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TampilDisplay" name="Tampilkan di Queue Display TV">
      <bpmn:documentation>Hirarki: 8.1. Realtime publish nomor antrian ke display. Zero PHI.</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CetakTiket" name="Cetak tiket antrian (thermal printer)">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Checkin" name="Pasien checked-in — menunggu panggilan triase">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Checkin" targetRef="Task_VerifIdentitas"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_VerifIdentitas" targetRef="Task_CocokanWajah"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Task_CocokanWajah" targetRef="GW_IdentitasOK"/>
    <bpmn:sequenceFlow id="F_Cocok" name="Ya" sourceRef="GW_IdentitasOK" targetRef="Merge_Identitas"/>
    <bpmn:sequenceFlow id="F_TidakCocok" name="Tidak" sourceRef="GW_IdentitasOK" targetRef="Task_PerbaikiData"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Task_PerbaikiData" targetRef="Merge_Identitas"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Merge_Identitas" targetRef="Task_VerifPenjamin"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_VerifPenjamin" targetRef="GW_TipePenjamin"/>
    <bpmn:sequenceFlow id="F_Umum" name="Umum" sourceRef="GW_TipePenjamin" targetRef="Merge_Penjamin"/>
    <bpmn:sequenceFlow id="F_BPJS" name="BPJS" sourceRef="GW_TipePenjamin" targetRef="Task_VerifBPJS"/>
    <bpmn:sequenceFlow id="F_Asuransi" name="Asuransi Swasta" sourceRef="GW_TipePenjamin" targetRef="Task_VerifAsuransi"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_VerifBPJS" targetRef="Merge_Penjamin"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_VerifAsuransi" targetRef="Merge_Penjamin"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Merge_Penjamin" targetRef="GW_PenjaminValid"/>
    <bpmn:sequenceFlow id="F_Valid" name="Ya" sourceRef="GW_PenjaminValid" targetRef="Merge_PenjaminOK"/>
    <bpmn:sequenceFlow id="F_TidakValid" name="Tidak" sourceRef="GW_PenjaminValid" targetRef="Task_FallbackUmum"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_FallbackUmum" targetRef="Merge_PenjaminOK"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Merge_PenjaminOK" targetRef="Task_KonfirmasiCheckin"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_KonfirmasiCheckin" targetRef="Task_BuatVisit"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_BuatVisit" targetRef="Task_StatusArrived"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_StatusArrived" targetRef="Task_BuatTiketAntrian"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_BuatTiketAntrian" targetRef="Task_TampilDisplay"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_TampilDisplay" targetRef="Task_CetakTiket"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_CetakTiket" targetRef="End_Checkin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_Checkin">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_Checkin" bpmnElement="Collab_Checkin">
      <bpmndi:BPMNShape id="Part_Checkin_di" bpmnElement="Part_Checkin" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="3976" height="400"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Reg_di" bpmnElement="Lane_Reg" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="3916" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistem_di" bpmnElement="Lane_Sistem" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="3916" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Checkin_di" bpmnElement="Start_Checkin">
        <dc:Bounds x="260" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235" y="143" width="86" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifIdentitas_di" bpmnElement="Task_VerifIdentitas">
        <dc:Bounds x="440" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CocokanWajah_di" bpmnElement="Task_CocokanWajah">
        <dc:Bounds x="620" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_IdentitasOK_di" bpmnElement="GW_IdentitasOK" isMarkerVisible="true">
        <dc:Bounds x="800" y="95" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="65" width="90" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PerbaikiData_di" bpmnElement="Task_PerbaikiData">
        <dc:Bounds x="980" y="190" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_Identitas_di" bpmnElement="Merge_Identitas" isMarkerVisible="true">
        <dc:Bounds x="1160" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifPenjamin_di" bpmnElement="Task_VerifPenjamin">
        <dc:Bounds x="1340" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_TipePenjamin_di" bpmnElement="GW_TipePenjamin" isMarkerVisible="true">
        <dc:Bounds x="1520" y="95" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1500" y="65" width="90" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifAsuransi_di" bpmnElement="Task_VerifAsuransi">
        <dc:Bounds x="1700" y="190" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifBPJS_di" bpmnElement="Task_VerifBPJS">
        <dc:Bounds x="1880" y="190" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_Penjamin_di" bpmnElement="Merge_Penjamin" isMarkerVisible="true">
        <dc:Bounds x="2060" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PenjaminValid_di" bpmnElement="GW_PenjaminValid" isMarkerVisible="true">
        <dc:Bounds x="2240" y="95" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2220" y="65" width="90" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FallbackUmum_di" bpmnElement="Task_FallbackUmum">
        <dc:Bounds x="2420" y="190" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_PenjaminOK_di" bpmnElement="Merge_PenjaminOK" isMarkerVisible="true">
        <dc:Bounds x="2600" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KonfirmasiCheckin_di" bpmnElement="Task_KonfirmasiCheckin">
        <dc:Bounds x="2780" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuatVisit_di" bpmnElement="Task_BuatVisit">
        <dc:Bounds x="2960" y="340" width="120" height="80"/>
      </bpmndi:BPMNShape>
