        <dc:Bounds x="3140" y="340" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuatTiketAntrian_di" bpmnElement="Task_BuatTiketAntrian">
        <dc:Bounds x="3320" y="340" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TampilDisplay_di" bpmnElement="Task_TampilDisplay">
        <dc:Bounds x="3500" y="340" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CetakTiket_di" bpmnElement="Task_CetakTiket">
        <dc:Bounds x="3680" y="340" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Checkin_di" bpmnElement="End_Checkin">
        <dc:Bounds x="3860" y="362" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3835" y="403" width="86" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01">
        <di:waypoint x="296" y="120"/>
        <di:waypoint x="440" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_di" bpmnElement="F02">
        <di:waypoint x="560" y="120"/>
        <di:waypoint x="620" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F03_di" bpmnElement="F03">
        <di:waypoint x="740" y="120"/>
        <di:waypoint x="800" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Cocok_di" bpmnElement="F_Cocok">
        <di:waypoint x="850" y="120"/>
