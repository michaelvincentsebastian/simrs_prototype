      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F05_di" bpmnElement="F05">
        <di:waypoint x="1210" y="120"/>
        <di:waypoint x="1340" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F06_di" bpmnElement="F06">
        <di:waypoint x="1460" y="120"/>
        <di:waypoint x="1520" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Umum_di" bpmnElement="F_Umum">
        <di:waypoint x="1570" y="120"/>
        <di:waypoint x="2060" y="120"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1800" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_BPJS_di" bpmnElement="F_BPJS">
        <di:waypoint x="1570" y="120"/>
        <di:waypoint x="1725" y="120"/>
        <di:waypoint x="1725" y="230"/>
        <di:waypoint x="1880" y="230"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1632" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Asuransi_di" bpmnElement="F_Asuransi">
        <di:waypoint x="1570" y="120"/>
        <di:waypoint x="1635" y="120"/>
        <di:waypoint x="1635" y="230"/>
        <di:waypoint x="1700" y="230"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1587" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F07_di" bpmnElement="F07">
        <di:waypoint x="2000" y="230"/>
        <di:waypoint x="2030" y="230"/>
        <di:waypoint x="2030" y="120"/>
        <di:waypoint x="2060" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F08_di" bpmnElement="F08">
        <di:waypoint x="1820" y="230"/>
        <di:waypoint x="1940" y="230"/>
        <di:waypoint x="1940" y="120"/>
        <di:waypoint x="2060" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F09_di" bpmnElement="F09">
        <di:waypoint x="2110" y="120"/>
        <di:waypoint x="2240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_di" bpmnElement="F_Valid">
        <di:waypoint x="2290" y="120"/>
        <di:waypoint x="2600" y="120"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2430" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TidakValid_di" bpmnElement="F_TidakValid">
        <di:waypoint x="2290" y="120"/>
        <di:waypoint x="2355" y="120"/>
        <di:waypoint x="2355" y="230"/>
        <di:waypoint x="2420" y="230"/>
