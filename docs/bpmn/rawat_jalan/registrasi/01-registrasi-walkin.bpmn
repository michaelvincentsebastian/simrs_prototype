<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RegWalkin" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collab_RegWalkin">
    <bpmn:participant id="Part_RegWalkin" name="Registrasi Walk-in (§1.2)" processRef="Proc_RegWalkin" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_RegWalkin" name="Registrasi Walk-in" isExecutable="false">
    <bpmn:documentation>
      Alur detail pendaftaran pasien rawat jalan walk-in (offline) di loket admisi pendaftaran.
      Mencakup: pemilahan mode Pasien Lama (pencarian RME via Nama/NIK/No. RM dan filter tanggal lahir/gender)
      vs Pasien Baru (input NIK 16 digit dengan deteksi duplikasi NIK real-time dan penerbitan MRN baru),
      pemilihan poliklinik tujuan &amp; DPJP praktik dengan validasi jadwal dan kuota slot kunjungan,
      serta pemilihan metode pembayaran/skema penjamin (BPJS Kesehatan, Asuransi Swasta, Perusahaan Penjamin
      kerjasama dengan input nama perusahaan &amp; kode penjamin, serta Pasien Umum dengan kanal bayar
      Cash, Credit/Debit, QRIS, dan VA beserta input detail transaksi).
      Diakhiri penerbitan kunjungan Outpatient Visit (WAITING_TRIAGE), tiket antrian triase (T-xxx), cetak thermal, dan audio bell.
      Hirarki: §1.2 Walk-in Registration, §1.5 Verifikasi Identitas, §1.6 Verifikasi Penjamin, §1.7 Antrian Rawat Jalan.
      Aktor: Pasien, Staf Registrasi Loket, Sistem SIMRS.
    </bpmn:documentation>
    <bpmn:laneSet id="LS_RegWalkin">
      <bpmn:lane id="Lane_Pasien" name="Pasien">
        <bpmn:flowNodeRef>Start_WalkIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DatangLoket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SerahkanIdentitasPenjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TerdaftarWalkin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TerimaTiketTriase</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_StafReg" name="Staf Registrasi (Loket)">
        <bpmn:flowNodeRef>GW_DuplikasiNIK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PeringatanDuplikat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_DataPasienOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihPoliDokter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CariPasienRME</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TerimaPasienBerkas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BukaModulRegistrasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputNIKPasienBaru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ModePendaftaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LengkapiFormPasienBaru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihPasienRME</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KuotaJadwal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TawarkanAlternatifDokter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputPerusahaanPenjamin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputVerifAsuransi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihKanalUmum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputVerifBPJS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitPendaftaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MetodePembayaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihMetodePembayaran</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem SIMRS">
        <bpmn:flowNodeRef>Task_CekDuplikasiNIK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateMRN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CekJadwalKuota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AudioBellDisplay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CetakTiketThermal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuatKunjunganVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateNomorTiket</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_WalkIn" name="Pasien datang langsung tanpa appointment (Walk-in)">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DatangLoket" name="Menuju loket pendaftaran rawat jalan">
      <bpmn:documentation>Pasien mengambil nomor antrian loket pendaftaran atau langsung menuju meja admisi</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SerahkanIdentitasPenjamin" name="Menyerahkan KTP/KIA &#38; kartu penjamin (BPJS/Polis/Surat Jaminan)">
      <bpmn:documentation>Pasien menyerahkan bukti identitas fisik dan kartu kepesertaan penjamin kepada petugas</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_DataPasienOK">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PilihPoliDokter" name="Pilih Poliklinik tujuan &#38; Dokter DPJP praktik">
      <bpmn:documentation>Hirarki: 1.2 › Pemilihan Poli &amp; Dokter. Dropdown poli aktif dan DPJP terjadwal.</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_WalkIn" targetRef="Task_DatangLoket" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_DatangLoket" targetRef="Task_SerahkanIdentitasPenjamin" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_SerahkanIdentitasPenjamin" targetRef="Task_TerimaPasienBerkas" />
    <bpmn:sequenceFlow id="F_PasienLama" name="Pasien Lama" sourceRef="GW_ModePendaftaran" targetRef="Task_CariPasienRME" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_CariPasienRME" targetRef="Task_PilihPasienRME" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_PilihPasienRME" targetRef="Merge_DataPasienOK" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_InputNIKPasienBaru" targetRef="Task_CekDuplikasiNIK" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_CekDuplikasiNIK" targetRef="GW_DuplikasiNIK" />
    <bpmn:sequenceFlow id="F_NIKDuplikat" name="NIK Terdaftar" sourceRef="GW_DuplikasiNIK" targetRef="Task_PeringatanDuplikat" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_PeringatanDuplikat" targetRef="Task_PilihPasienRME" />
    <bpmn:sequenceFlow id="F_NIKBaru" name="NIK Baru" sourceRef="GW_DuplikasiNIK" targetRef="Task_LengkapiFormPasienBaru" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_LengkapiFormPasienBaru" targetRef="Task_GenerateMRN" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_GenerateMRN" targetRef="Merge_DataPasienOK" />
    <bpmn:sequenceFlow id="F13" sourceRef="Merge_DataPasienOK" targetRef="Task_PilihPoliDokter" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_PilihPoliDokter" targetRef="Task_CekJadwalKuota" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_CekJadwalKuota" targetRef="GW_KuotaJadwal" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_TawarkanAlternatifDokter" targetRef="Task_PilihPoliDokter" />
    <bpmn:sequenceFlow id="F_KuotaOK" name="Tersedia" sourceRef="GW_KuotaJadwal" targetRef="Task_PilihMetodePembayaran" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_PilihMetodePembayaran" targetRef="GW_MetodePembayaran" />
    <bpmn:sequenceFlow id="F_BPJS" name="BPJS Kesehatan" sourceRef="GW_MetodePembayaran" targetRef="Task_InputVerifBPJS" />
    <bpmn:sequenceFlow id="F_Asuransi" name="Asuransi Swasta" sourceRef="GW_MetodePembayaran" targetRef="Task_InputVerifAsuransi" />
    <bpmn:sequenceFlow id="F_Perusahaan" name="Perusahaan Penjamin" sourceRef="GW_MetodePembayaran" targetRef="Task_InputPerusahaanPenjamin" />
    <bpmn:sequenceFlow id="F_Umum" name="Umum / Mandiri" sourceRef="GW_MetodePembayaran" targetRef="Task_PilihKanalUmum" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_SubmitPendaftaran" targetRef="Task_BuatKunjunganVisit" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_AudioBellDisplay" targetRef="Task_TerimaTiketTriase" />
    <bpmn:userTask id="Task_PeringatanDuplikat" name="Peringatan NIK ganda: konfirmasi dan beralih ke Pasien Lama">
      <bpmn:documentation>Banner peringatan muncul: NIK telah terdaftar atas nama pasien aktif. Staf diarahkan memilih data pasien lama.</bpmn:documentation>
      <bpmn:incoming>F_NIKDuplikat</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_DuplikasiNIK" name="Apakah NIK sudah terdaftar?" default="F_NIKBaru">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F_NIKDuplikat</bpmn:outgoing>
      <bpmn:outgoing>F_NIKBaru</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CariPasienRME" name="Cari data RME (Nama / NIK / No. RM &#38; filter Tgl Lahir / Gender)">
      <bpmn:documentation>Hirarki: 1.2 Walk-in › Pencarian pasien RME. Filter tanggal lahir &amp; gender untuk membedakan nama serupa.</bpmn:documentation>
      <bpmn:incoming>F_PasienLama</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TerimaPasienBerkas" name="Staf menerima pasien &#38; memeriksa berkas identitas">
      <bpmn:documentation>Petugas loket menyapa pasien dan menerima berkas fisik identitas dan penjamin</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BukaModulRegistrasi" name="Buka modul Pendaftaran Walk-in (Pilihan Mode: Lama / Baru)">
      <bpmn:documentation>Staf membuka antarmuka pendaftaran walk-in loket di sistem SIMRS Mini</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputNIKPasienBaru" name="Input NIK 16 digit pada formulir Pasien Baru">
      <bpmn:documentation>Hirarki: 1.2 › Registrasi Pasien Baru. Input NIK 16 digit sesuai KTP/KIA.</bpmn:documentation>
      <bpmn:incoming>F_PasienBaru</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ModePendaftaran" name="Status pendaftaran pasien?" default="F_PasienLama">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F_PasienLama</bpmn:outgoing>
      <bpmn:outgoing>F_PasienBaru</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F04" sourceRef="Task_TerimaPasienBerkas" targetRef="Task_BukaModulRegistrasi" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_BukaModulRegistrasi" targetRef="GW_ModePendaftaran" />
    <bpmn:sequenceFlow id="F_PasienBaru" name="Pasien Baru" sourceRef="GW_ModePendaftaran" targetRef="Task_InputNIKPasienBaru" />
    <bpmn:userTask id="Task_LengkapiFormPasienBaru" name="Input formulir data diri (Nama, TTL, Gender, HP, Alamat, Gol Darah)">
      <bpmn:documentation>Staf melengkapi formulir pendaftaran identitas pasien baru secara lengkap</bpmn:documentation>
      <bpmn:incoming>F_NIKBaru</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PilihPasienRME" name="Pilih pasien &#38; sistem fetch data diri serta riwayat penjamin">
      <bpmn:documentation>Sistem memuat data demografi lengkap pasien (Nama, NIK, No. RM, TTL, alamat, HP, dan default penjamin)</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_KuotaJadwal" name="Kuota &#38; jadwal DPJP tersedia?" default="F_KuotaOK">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F_KuotaOK</bpmn:outgoing>
      <bpmn:outgoing>F_KuotaPenuh</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_TawarkanAlternatifDokter" name="Tawarkan dokter pengganti atau sesi praktik lain ke pasien">
      <bpmn:documentation>Jika kuota dokter habis atau dokter tidak praktik, tawarkan alternatif poli/dokter lain</bpmn:documentation>
      <bpmn:incoming>F_KuotaPenuh</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_KuotaPenuh" name="Kuota Penuh" sourceRef="GW_KuotaJadwal" targetRef="Task_TawarkanAlternatifDokter" />
    <bpmn:userTask id="Task_InputPerusahaanPenjamin" name="Input Nama Perusahaan Penjamin &#38; Kode Penjamin / Surat Jaminan (GL)">
      <bpmn:documentation>Input nama instansi/perusahaan penjamin rekanan dan kode penjamin dari perusahaan serta nomor surat jaminan (GL)</bpmn:documentation>
      <bpmn:incoming>F_Perusahaan</bpmn:incoming>
      <bpmn:outgoing>Flow_0ezkies</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputVerifAsuransi" name="Input No. Polis Asuransi &#38; verifikasi polis provider aktif">
      <bpmn:documentation>Input nomor kartu/polis asuransi swasta rekanan (Prudential, Allianz, Sinarmas, dll) dan verifikasi plafon</bpmn:documentation>
      <bpmn:incoming>F_Asuransi</bpmn:incoming>
      <bpmn:outgoing>Flow_1qf8wxx</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PilihKanalUmum" name="Pilih kanal bayar Umum (Cash, Credit, QRIS, VA) &#38; input detail transaksi">
      <bpmn:documentation>Pilih submetode bayar: Cash (catatan/nominal), Credit/Debit (bank penerbit, 4 digit kartu, approval code), QRIS (provider &amp; RRN), VA (bank &amp; no VA billing)</bpmn:documentation>
      <bpmn:incoming>F_Umum</bpmn:incoming>
      <bpmn:outgoing>Flow_1muyp1h</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputVerifBPJS" name="Input No. Kartu BPJS &#38; verifikasi eligibility rujukan faskes">
      <bpmn:documentation>Input nomor kartu BPJS / NIK, validasi keaktifan kepesertaan JKN dan bridging rujukan faskes 1</bpmn:documentation>
      <bpmn:incoming>F_BPJS</bpmn:incoming>
      <bpmn:outgoing>Flow_0fbzp5f</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0fbzp5f" sourceRef="Task_InputVerifBPJS" targetRef="Task_SubmitPendaftaran" />
    <bpmn:sequenceFlow id="Flow_1muyp1h" sourceRef="Task_PilihKanalUmum" targetRef="Task_SubmitPendaftaran" />
    <bpmn:sequenceFlow id="Flow_1qf8wxx" sourceRef="Task_InputVerifAsuransi" targetRef="Task_SubmitPendaftaran" />
    <bpmn:sequenceFlow id="Flow_0ezkies" sourceRef="Task_InputPerusahaanPenjamin" targetRef="Task_SubmitPendaftaran" />
    <bpmn:userTask id="Task_SubmitPendaftaran" name="Klik Daftarkan &#38; Cetak Tiket (Konfirmasi pendaftaran)">
      <bpmn:documentation>Petugas mengonfirmasi ringkasan data pendaftaran kepada pasien dan menekan tombol daftarkan</bpmn:documentation>
      <bpmn:incoming>Flow_0fbzp5f</bpmn:incoming>
      <bpmn:incoming>Flow_1muyp1h</bpmn:incoming>
      <bpmn:incoming>Flow_1qf8wxx</bpmn:incoming>
      <bpmn:incoming>Flow_0ezkies</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_TerdaftarWalkin" name="Pasien terdaftar &#38; menuju ruang tunggu Triase Rawat Jalan">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_TerimaTiketTriase" name="Pasien menerima bukti pendaftaran &#38; tiket antrian triase">
      <bpmn:documentation>Pasien mengambil tiket fisik yang diserahkan petugas loket pendaftaran</bpmn:documentation>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F29" sourceRef="Task_TerimaTiketTriase" targetRef="End_TerdaftarWalkin" />
    <bpmn:serviceTask id="Task_CekDuplikasiNIK" name="Sistem validasi format &#38; deteksi duplikasi NIK real-time">
      <bpmn:documentation>Mencegah duplikasi nomor rekam medis jika NIK telah terdaftar sebelumnya (§1.5)</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateMRN" name="Sistem generate Nomor Rekam Medis (MRN) baru otomatis">
      <bpmn:documentation>Sistem otomatis membuat identifier MRN unik (format RM-YYYY-xxxx)</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CekJadwalKuota" name="Sistem verifikasi jadwal praktik dokter &#38; sisa kuota slot">
      <bpmn:documentation>Sistem memverifikasi jam praktik, ruangan poli, dan ketersediaan kuota antrian dokter</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AudioBellDisplay" name="Putar audio bell pemanggilan antrian &#38; perbarui display loket">
      <bpmn:documentation>Sistem memutar suara panggil nomor antrian dan memperbarui antrian pada display televisi ruang tunggu</bpmn:documentation>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CetakTiketThermal" name="Cetak bukti pendaftaran &#38; tiket antrian thermal">
      <bpmn:documentation>Printer loket mencetak bukti pendaftaran resmi dan tiket nomor antrian triase ber-QR code</bpmn:documentation>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuatKunjunganVisit" name="Sistem buat Outpatient Visit (Status: WAITING_TRIAGE)">
      <bpmn:documentation>Sistem membuat dokumen kunjungan rawat jalan (OPV-2026-xxxx) dengan status WAITING_TRIAGE dan tautan poli &amp; dokter</bpmn:documentation>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateNomorTiket" name="Sistem generate nomor tiket antrian triase otomatis (T-xxx)">
      <bpmn:documentation>Hirarki: 1.7 Antrian Rawat Jalan. Penomoran antrian triase otomatis berurutan (T-xxx).</bpmn:documentation>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F27" sourceRef="Task_CetakTiketThermal" targetRef="Task_AudioBellDisplay" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_GenerateNomorTiket" targetRef="Task_CetakTiketThermal" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_BuatKunjunganVisit" targetRef="Task_GenerateNomorTiket" />
    <bpmn:exclusiveGateway id="GW_MetodePembayaran" name="Pilihan Skema Pembayaran?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F_BPJS</bpmn:outgoing>
      <bpmn:outgoing>F_Asuransi</bpmn:outgoing>
      <bpmn:outgoing>F_Perusahaan</bpmn:outgoing>
      <bpmn:outgoing>F_Umum</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PilihMetodePembayaran" name="Pilih Metode Pembayaran / Skema Penjamin (§1.6)">
      <bpmn:documentation>Hirarki: 1.6 Verifikasi Penjamin. Petugas menanyakan metode penjaminan/pembayaran yang digunakan pasien.</bpmn:documentation>
      <bpmn:incoming>F_KuotaOK</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
