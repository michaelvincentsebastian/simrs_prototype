        <dc:Bounds x="2960" y="95" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2940" y="65" width="90" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DatangLoket_di" bpmnElement="Task_DatangLoket">
        <dc:Bounds x="3140" y="190" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanQR_di" bpmnElement="Task_ScanQR">
        <dc:Bounds x="3320" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CariBooking_di" bpmnElement="Task_CariBooking">
        <dc:Bounds x="3320" y="660" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidasiQR_di" bpmnElement="Task_ValidasiQR">
        <dc:Bounds x="3500" y="500" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KonfirmasiManual_di" bpmnElement="Task_KonfirmasiManual">
        <dc:Bounds x="3500" y="660" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_Checkin_di" bpmnElement="Merge_Checkin" isMarkerVisible="true">
        <dc:Bounds x="3680" y="515" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StatusArrived_di" bpmnElement="Task_StatusArrived">
        <dc:Bounds x="3860" y="500" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CheckedIn_di" bpmnElement="End_CheckedIn">
        <dc:Bounds x="4040" y="522" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="4015" y="563" width="86" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01">
        <di:waypoint x="296" y="120"/>
        <di:waypoint x="440" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_di" bpmnElement="F02">
        <di:waypoint x="560" y="120"/>
        <di:waypoint x="620" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F03_di" bpmnElement="F03">
        <di:waypoint x="740" y="120"/>
        <di:waypoint x="770" y="120"/>
        <di:waypoint x="770" y="380"/>
        <di:waypoint x="800" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F04_di" bpmnElement="F04">
        <di:waypoint x="920" y="380"/>
