        <di:waypoint x="2960" y="360"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2712" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Stabil_di" bpmnElement="F_Stabil">
        <di:waypoint x="2650" y="120"/>
        <di:waypoint x="2715" y="120"/>
        <di:waypoint x="2715" y="470"/>
        <di:waypoint x="2780" y="470"/>
        <bpmndi:BPMNLabel>
