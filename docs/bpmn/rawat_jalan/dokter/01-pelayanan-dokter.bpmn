      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="2000" y="280"/>
        <di:waypoint x="2060" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_AdaTindakan_di" bpmnElement="F_AdaTindakan">
        <di:waypoint x="2110" y="280"/>
