          <dc:Bounds x="3835" y="163" width="86" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01">
        <di:waypoint x="296" y="140"/>
        <di:waypoint x="368" y="140"/>
        <di:waypoint x="368" y="280"/>
        <di:waypoint x="440" y="280"/>
      </bpmndi:BPMNEdge>
