<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PelayananDokter" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collab_PelayananDokter">
    <bpmn:participant id="Part_PelayananDokter" name="Pelayanan Rawat Jalan Dokter Spesialis / Umum (§3.1-3.12)" processRef="Proc_PelayananDokter"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_PelayananDokter" name="Pelayanan Dokter" isExecutable="false">
    <bpmn:documentation>
      Alur lengkap konsultasi dan tindakan medis dokter di poliklinik rawat jalan.
      Mencakup pemanggilan, review rekam medis sebelumnya, anamnesis, pemeriksaan fisik,
      penegakan diagnosis (ICD-10), tindakan medis (ICD-9-CM), peresepan elektronik (e-Prescription),
      rencana tindak lanjut/kontrol, dan finalisasi resume encounter.
      Hirarki: §3.1-§3.12 Modul Pelayanan Dokter.
    </bpmn:documentation>
    <bpmn:laneSet id="LS_PelayananDokter">
      <bpmn:lane id="Lane_Sistem" name="Sistem SIMRS Mini">
        <bpmn:flowNodeRef>Start_PasienTibaDiPoli</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AmbilDataTriaseTTV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidasiInteraksiObat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LockEncounter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RouteNextService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SelesaiDokter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dokter" name="Dokter Pemeriksa">
        <bpmn:flowNodeRef>Task_PanggilDanBukaEncounter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRiwayatMedis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Anamnesis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PemeriksaanFisik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputDiagnosisICD10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PerluTindakan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputTindakanICD9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PerluResep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputResepObat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuatRencanaKontrol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalisasiEncounter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pasien" name="Pasien">
        <bpmn:flowNodeRef>Task_MasukKonsultasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JawabKeluhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MenjalaniPemeriksaan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EdukasiRencanaTerapi</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_PasienTibaDiPoli" name="Pasien antri di poli tujuan (Status: WAITING_DOCTOR)">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PanggilDanBukaEncounter" name="Dokter memanggil pasien &amp; buka Patient Encounter (§3.1-3.2)">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_AmbilDataTriaseTTV" name="Load otomatis data TTV triase &amp; ringkasan RME pasien">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MasukKonsultasi" name="Pasien masuk ke ruang periksa dokter">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewRiwayatMedis" name="Dokter telaah riwayat medis, alergi, dan hasil pemeriksaan sebelumnya (§3.3)">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Anamnesis" name="Dokter melakukan anamnesis terstruktur (§3.4)">
      <bpmn:documentation>Keluhan utama, riwayat penyakit sekarang, riwayat pengobatan, dsb.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_JawabKeluhan" name="Pasien memberikan keterangan medis">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PemeriksaanFisik" name="Pemeriksaan fisik dokter (§3.5)">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MenjalaniPemeriksaan" name="Pasien menjalani pemeriksaan fisik">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputDiagnosisICD10" name="Input Diagnosis ICD-10 Utama &amp; Sekunder (§3.6)">
      <bpmn:documentation>Wajib minimal 1 primary diagnosis dengan kode ICD-10 valid</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_PerluTindakan" name="Apakah ada tindakan medis / prosedur?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F_AdaTindakan</bpmn:outgoing>
      <bpmn:outgoing>F_TanpaTindakan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_InputTindakanICD9" name="Input Prosedur Medis (ICD-9-CM &amp; Tarif) (§3.7)">
      <bpmn:documentation>Prosedur medis poliklinik tercatat ke Clinical Procedure</bpmn:documentation>
      <bpmn:incoming>F_AdaTindakan</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_PerluResep" name="Apakah memerlukan resep obat?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F_TanpaTindakan</bpmn:incoming>
      <bpmn:outgoing>F_AdaResep</bpmn:outgoing>
      <bpmn:outgoing>F_TanpaResep</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_InputResepObat" name="Input e-Prescription / Resep Obat (§3.8)">
      <bpmn:documentation>Item obat, dosis, frekuensi (signa), rute, durasi, racikan/non-racikan</bpmn:documentation>
      <bpmn:incoming>F_AdaResep</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiInteraksiObat" name="Sistem validasi alergi &amp; interaksi obat otomatis">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_BuatRencanaKontrol" name="Tentukan Rencana Tindak Lanjut &amp; Kontrol (§3.10)">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F_TanpaResep</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EdukasiRencanaTerapi" name="Pasien menerima edukasi rencana terapi &amp; anjuran dokter">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FinalisasiEncounter" name="Dokter finalisasi dan tandatangani Encounter (§3.11)">
      <bpmn:documentation>Submit Patient Encounter: catatan medis dikunci tidak bisa diubah</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LockEncounter" name="Kunci Encounter &amp; Generate Tagihan Layanan Dokter">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RouteNextService" name="Update Status Visit: WAITING_PHARMACY / WAITING_BILLING">
      <bpmn:documentation>Tiket dokter COMPLETED, routing ke antrian farmasi/kasir</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_SelesaiDokter" name="Pelayanan Dokter Selesai">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_PasienTibaDiPoli" targetRef="Task_PanggilDanBukaEncounter"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_PanggilDanBukaEncounter" targetRef="Task_AmbilDataTriaseTTV"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Task_AmbilDataTriaseTTV" targetRef="Task_MasukKonsultasi"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Task_MasukKonsultasi" targetRef="Task_ReviewRiwayatMedis"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_ReviewRiwayatMedis" targetRef="Task_Anamnesis"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_Anamnesis" targetRef="Task_JawabKeluhan"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_JawabKeluhan" targetRef="Task_PemeriksaanFisik"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_PemeriksaanFisik" targetRef="Task_MenjalaniPemeriksaan"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_MenjalaniPemeriksaan" targetRef="Task_InputDiagnosisICD10"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_InputDiagnosisICD10" targetRef="GW_PerluTindakan"/>
    <bpmn:sequenceFlow id="F_AdaTindakan" name="Ada Prosedur" sourceRef="GW_PerluTindakan" targetRef="Task_InputTindakanICD9"/>
    <bpmn:sequenceFlow id="F_TanpaTindakan" name="Tanpa Prosedur" sourceRef="GW_PerluTindakan" targetRef="GW_PerluResep"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_InputTindakanICD9" targetRef="GW_PerluResep"/>
    <bpmn:sequenceFlow id="F_AdaResep" name="Ada Resep" sourceRef="GW_PerluResep" targetRef="Task_InputResepObat"/>
    <bpmn:sequenceFlow id="F_TanpaResep" name="Tanpa Resep" sourceRef="GW_PerluResep" targetRef="Task_BuatRencanaKontrol"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_InputResepObat" targetRef="Task_ValidasiInteraksiObat"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ValidasiInteraksiObat" targetRef="Task_BuatRencanaKontrol"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_BuatRencanaKontrol" targetRef="Task_EdukasiRencanaTerapi"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_EdukasiRencanaTerapi" targetRef="Task_FinalisasiEncounter"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_FinalisasiEncounter" targetRef="Task_LockEncounter"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_LockEncounter" targetRef="Task_RouteNextService"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_RouteNextService" targetRef="End_SelesaiDokter"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_PelayananDokter">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_PelayananDokter" bpmnElement="Collab_PelayananDokter">
