        <bpmndi:BPMNLabel>
          <dc:Bounds x="2160" y="262" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TanpaTindakan_di" bpmnElement="F_TanpaTindakan">
        <di:waypoint x="2110" y="280"/>
        <di:waypoint x="2265" y="280"/>
        <di:waypoint x="2265" y="390"/>
        <di:waypoint x="2420" y="390"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2172" y="262" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="2360" y="280"/>
        <di:waypoint x="2390" y="280"/>
        <di:waypoint x="2390" y="390"/>
        <di:waypoint x="2420" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_AdaResep_di" bpmnElement="F_AdaResep">
        <di:waypoint x="2470" y="390"/>
        <di:waypoint x="2535" y="390"/>
        <di:waypoint x="2535" y="280"/>
        <di:waypoint x="2600" y="280"/>
